AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Optional trusted-LAN API gate. Use a random value with at least 32 characters.
COMPANION_ACCESS_TOKEN=
API_RATE_LIMIT_PER_MINUTE=40
# Local Node default: ./data/memories.sqlite. Docker Compose overrides this to its persistent volume.
MEMORY_DB_PATH=./data/memories.sqlite
